{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": "./",   // Add baseUrl to allow non-relative imports
    "paths": {
      "@/*": ["src/*"],  // Adjust the paths to match your project structure
      "@lib/*": ["lib/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*",  
    "types/**/*",         // Include the 'src' folder
    ".next/types/**/*.ts"
, "lib", "lib"  ],
  "exclude": ["node_modules"]
}
